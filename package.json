{
  "name": "reactively",
  "version": "0.1.0",
  "private": true,
  "description": "Reactively - React Native, visually. A visual React Native application builder.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@reactively/eslint-config": "workspace:*",
    "@reactively/typescript-config": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "rimraf": "6.0.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
